import CompND.Preamble

/-- The smallest family of vector fields on `ℝⁿ` containing the frame fields
`x ↦ sig x i` and closed under the Lie bracket; the Lie algebra generated by the frame,
whose pointwise values appear in Hörmander's rank condition eq:horcond. -/
def LieHull {n m : ℕ}
    (sig : EuclideanSpace ℝ (Fin n) → Fin m → EuclideanSpace ℝ (Fin n)) :
    Set (EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) :=
  ⋂₀ {S | (∀ i, (fun y => sig y i) ∈ S) ∧
          ∀ V ∈ S, ∀ W ∈ S, VectorField.lieBracket ℝ V W ∈ S}
